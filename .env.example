# Copiez ce fichier en .env.local et remplissez avec vos valeurs Supabase
# (Project Settings → API dans le dashboard Supabase)

NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# NE JAMAIS exposer cette clé côté client / NEXT_PUBLIC_.
# Utilisée uniquement dans les Route Handlers / Server Actions / Edge Functions.
SUPABASE_SERVICE_ROLE_KEY=eyJxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Secret serveur utilisé pour saler le hash des clés API des devices IoT
# (src/lib/device-auth.ts). Générez une valeur aléatoire longue et unique
# par environnement (ex: openssl rand -hex 32).
DEVICE_KEY_PEPPER=changez-moi-en-production
